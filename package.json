{
  "name": "reelforge",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop app: short brief -> script -> voiceover -> deterministic voxel 3D animation -> MP4, powered by the local Claude Code CLI.",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @reelforge/desktop dev",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:render": "node scripts/test-render.mjs",
    "kit:catalog": "node scripts/kit-catalog.mjs",
    "test:app": "pnpm --filter @reelforge/desktop build && vitest run --project app",
    "render:frames": "node packages/engine/scripts/run-cli.mjs render-frames",
    "lint:scene": "node packages/engine/scripts/run-cli.mjs lint",
    "build": "tsc -b && pnpm --filter @reelforge/desktop build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
